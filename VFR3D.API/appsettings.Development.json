{
  "CloudStorage": {
    "UseManagedIdentity": false
  },
  "Database": {
    "Host": "localhost",
    "Database": "vfr3d_development_database",
    "Username": "vfr3d_development_user",
    "Port": 5432
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "NmsSettings": {
    "CacheDurationMinutes": 5,
    "DefaultRouteCorridorRadiusNm": 25,
    "RequestTimeoutSeconds": 30
  }
}